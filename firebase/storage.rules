rules_version = '2';
// Fotos de produtos, banners e prêmios: todos veem, só a loja envia.
// A loja pode ser o dono pelo telefone (ownerByPhone) ou um uid em admins/list.
service firebase.storage {
  match /b/{bucket}/o {
    match /assets/{file} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*')
        && (
          request.auth.token.phone_number in ['+5521959240452']
          || request.auth.uid in firestore.get(/databases/(default)/documents/admins/list).data.uids
        );
      allow delete: if request.auth != null
        && (
          request.auth.token.phone_number in ['+5521959240452']
          || request.auth.uid in firestore.get(/databases/(default)/documents/admins/list).data.uids
        );
    }
  }
}
