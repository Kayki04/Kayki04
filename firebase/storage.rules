rules_version = '2';
// Fotos de produtos, banners e prêmios: todos veem, só a loja envia.
// A loja pode ser o dono pelo telefone (ownerByPhone) ou um uid em admins/list.
service firebase.storage {
  match /b/{bucket}/o {
    match /assets/{file} {
      allow read: if true;
      // Qualquer usuário logado envia foto (até 10MB) ou vídeo (até 60MB) — fotos de produto (loja),
      // foto do pet e mídia do feed dos parceiros. Nomes aleatórios; conteúdo validado por tipo/tamanho.
      allow write: if request.auth != null
        && (
          (request.resource.contentType.matches('image/.*') && request.resource.size < 10 * 1024 * 1024)
          || (request.resource.contentType.matches('video/.*') && request.resource.size < 60 * 1024 * 1024)
        );
      allow delete: if request.auth != null;
    }
  }
}
