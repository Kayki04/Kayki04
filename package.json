{
  "name": "gatecao-app",
  "version": "1.0.0",
  "private": true,
  "description": "App nativo (Android/iOS) da Gatecão Pet Shop, empacotado com Capacitor a partir do build web em public/.",
  "scripts": {
    "build:web": "python3 tools/build_firebase.py",
    "sync": "npm run build:web && npx cap sync",
    "open:android": "npx cap open android",
    "open:ios": "npx cap open ios",
    "assets": "npx @capacitor/assets generate --iconBackgroundColor '#FF7A00' --iconBackgroundColorDark '#FF7A00' --splashBackgroundColor '#FF7A00'"
  },
  "dependencies": {
    "@capacitor/android": "6.2.0",
    "@capacitor/app": "6.0.2",
    "@capacitor/core": "6.2.0",
    "@capacitor/ios": "6.2.0",
    "@capacitor/push-notifications": "6.0.4",
    "@capacitor/splash-screen": "6.0.3",
    "@capacitor/status-bar": "6.0.2"
  },
  "devDependencies": {
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "6.2.0"
  }
}
